# Sentinel Environment Configuration
#
# Copy to .env and set values as needed. NEVER commit .env to the repository.

# ── Provider Selection ─────────────────────────────────────────
# SENTINEL_PROVIDER = anthropic | openai | github-models | copilot-cli
# If unset, Sentinel auto-detects from the keys below (Anthropic, then OpenAI,
# then GitHub Models when opted in).
# SENTINEL_PROVIDER=openai

# ── Provider credentials ───────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# GitHub Models is opt-in:
# SENTINEL_ALLOW_GITHUB_MODELS=true
# GITHUB_TOKEN=
# GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
#
# copilot-cli uses the locally installed, logged-in GitHub Copilot CLI and
# needs no key.

# ── Model ──────────────────────────────────────────────────────
# Model identifier. Default depends on the provider (see README).
# SENTINEL_MODEL=gpt-5.1

# ── Local-only mode ───────────────────────────────────────────
# Set true to run without any external model/token dependency.
# SENTINEL_LOCAL_ONLY_MODE=true

# ── Review mode ───────────────────────────────────────────────
# Single-operator mode (no GitHub PR gate):
# SENTINEL_SELF_APPROVE=false

# Enforce designated GitHub PR approver (team can submit PRs, designated approver merges)
# SENTINEL_ENFORCE_SINGLE_PR_APPROVER=false
# SENTINEL_REQUIRED_PR_APPROVER=your-github-login
# Optional explicit operator identity override (otherwise GITHUB_ACTOR or `gh api user` login is used)
# SENTINEL_OPERATOR=

# Base branch for PR creation (gh pr create --base / compare-URL fallback).
# Defaults to "main"; set this when the target repo's default branch differs.
# SENTINEL_BASE_BRANCH=main

# Bypass manual review confirmation for trusted operators:
# SENTINEL_AUTO_APPROVE_WITHOUT_REVIEW=false

# ── Review depth & quality ────────────────────────────────────
# Specialist selection profile:
#   triggered         = Quick Review findings drive the full specialist suite
#   reliability-first = fixed reliability subset always-on (default)
# SENTINEL_REVIEW_PROFILE=reliability-first
#
# Full-coverage mode: review every in-scope line (no chunk cap / no sampling)
# and enable the coverage-certificate + quality-scorecard gates.
# SENTINEL_STRICT_QUALITY_MODE=false
#
# Run every specialist on every chunk (heaviest; ignores Quick-Review triaging):
# SENTINEL_ENFORCE_FULL_SPECIALIST_COVERAGE=false
#
# Stage 4c conceptual-lens grouping (embedding + HDBSCAN clustering).
# Defaults ON. Set false to skip the (expensive) clustering when only the
# structural lens / decision brief is needed; not forced on by strict mode.
# SENTINEL_ENABLE_CONCEPT_THEMES=true

# ── Paths ─────────────────────────────────────────────────────
# SENTINEL_REPO_PATH=/path/to/target/repo
# SENTINEL_STATE_DIR=sentinel/state

# ── Limits ────────────────────────────────────────────────────
# SENTINEL_MAX_TOKENS=8192
# SENTINEL_CHUNK_MAX_LINES=300
# SENTINEL_CHUNK_OVERLAP_LINES=80
# Maximum Python files sampled for dependency import context (Stage 2).
# Files are chosen via stratified sampling across directories, with entry
# points (__init__.py, main.py, cli.py, etc.) always included first.
# Set SENTINEL_STRICT_QUALITY_MODE=true to scan all files (no cap).
# SENTINEL_DEP_SCAN_LIMIT=500

# ── Logging ───────────────────────────────────────────────────
# SENTINEL_LOG_LEVEL=INFO
# SENTINEL_ALLOW_DEBUG_LOGGING=false
